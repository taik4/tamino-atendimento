# Copie para .env e preencha. NUNCA commitar o .env.
# O jeito fácil é rodar `uv run renovar.py login`: ele preenche TAMINO_COOKIE e EVO_TOKEN sozinho.

# Tamino backoffice: cookie da sessão admin (gw_admin_session=...; gw_csrf=...)
TAMINO_COOKIE=gw_admin_session=COLE_AQUI; gw_csrf=COLE_AQUI

# Evo CRM: só o JWT (sem "Bearer "), começa com eyJ
EVO_TOKEN=eyJCOLE_AQUI

# --- opcionais ---
# Rascunhos/tradução pela API da Anthropic (sem isso usa o Claude Code instalado)
# ANTHROPIC_API_KEY=sk-ant-...
# Tradução pelo Google Cloud Translation
# GOOGLE_TRANSLATE_KEY=...
# Token de longa duração do Claude Code (gere com `claude setup-token`)
# CLAUDE_CODE_OAUTH_TOKEN=...

# Endereços (só mude se os sistemas mudarem de domínio)
# TAMINO_API=https://api.tamino.com.br
# TAMINO_WEB=https://admin.tamino.com.br
# EVO_API=https://api-evo.dlip.com.br/api/v1
# EVO_WEB=https://evo.dlip.com.br
